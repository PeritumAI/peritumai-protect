{
  "id": "builtin.secrets",
  "name": "Secrets and keys",
  "version": "1.0.0",
  "description": "Deterministic secret patterns. No network. No model.",
  "enabled": true,
  "rules": [
    {
      "id": "secret.aws_access_key",
      "label": "AWS access key",
      "displayLabel": "AWS access key",
      "plural": "AWS access keys",
      "kind": "regex",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
      "placeholder": "AWS_KEY",
      "severity": "high"
    },
    {
      "id": "secret.github_pat",
      "label": "GitHub token",
      "displayLabel": "GitHub token",
      "plural": "GitHub tokens",
      "kind": "prefix",
      "patterns": ["ghp_", "github_pat_", "gho_", "ghu_", "ghs_"],
      "minLength": 20,
      "placeholder": "GITHUB_TOKEN",
      "severity": "high"
    },
    {
      "id": "secret.stripe",
      "label": "Stripe key",
      "displayLabel": "Stripe key",
      "plural": "Stripe keys",
      "kind": "prefix",
      "patterns": ["sk_live_", "sk_test_", "rk_live_"],
      "minLength": 16,
      "placeholder": "STRIPE_KEY",
      "severity": "high"
    },
    {
      "id": "secret.slack",
      "label": "Slack token",
      "displayLabel": "Slack token",
      "plural": "Slack tokens",
      "kind": "regex",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
      "placeholder": "SLACK_TOKEN",
      "severity": "high"
    },
    {
      "id": "secret.openai_sk",
      "label": "OpenAI-style key",
      "displayLabel": "OpenAI-style key",
      "plural": "OpenAI-style keys",
      "kind": "regex",
      "pattern": "\\bsk-[A-Za-z0-9_-]{16,}\\b",
      "placeholder": "API_KEY",
      "severity": "high",
      "notes": "Generic sk- prefix used in tests and many vendors"
    },
    {
      "id": "secret.jwt",
      "label": "JWT",
      "displayLabel": "JWT",
      "plural": "JWTs",
      "kind": "regex",
      "pattern": "\\beyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
      "placeholder": "JWT",
      "severity": "high"
    },
    {
      "id": "secret.pem",
      "label": "Private key block",
      "displayLabel": "private key block",
      "plural": "private key blocks",
      "kind": "pem-block",
      "patterns": [
        "BEGIN RSA PRIVATE KEY",
        "BEGIN OPENSSH PRIVATE KEY",
        "BEGIN PRIVATE KEY",
        "BEGIN EC PRIVATE KEY",
        "BEGIN DSA PRIVATE KEY",
        "BEGIN ENCRYPTED PRIVATE KEY",
        "BEGIN PGP PRIVATE KEY BLOCK"
      ],
      "placeholder": "PRIVATE_KEY",
      "severity": "block"
    },
    {
      "id": "secret.entropy",
      "label": "High-entropy string",
      "displayLabel": "high-entropy string",
      "plural": "high-entropy strings",
      "kind": "entropy",
      "minLength": 32,
      "entropyBits": 4.0,
      "placeholder": "SECRET",
      "severity": "warn",
      "enabled": true,
      "notes": "Easy to turn off if noisy"
    },
    {
      "id": "secret.google_api",
      "label": "Google API key",
      "displayLabel": "Google API key",
      "plural": "API keys",
      "kind": "regex",
      "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
      "placeholder": "GOOGLE_KEY",
      "severity": "high"
    },
    {
      "id": "secret.aws_temp",
      "label": "AWS temporary key",
      "displayLabel": "AWS temporary key",
      "plural": "AWS temporary keys",
      "kind": "regex",
      "pattern": "\\bASIA[0-9A-Z]{16}\\b",
      "placeholder": "AWS_KEY",
      "severity": "high"
    },
    {
      "id": "secret.aws_secret",
      "label": "AWS secret key",
      "displayLabel": "AWS secret key",
      "plural": "AWS secret keys",
      "kind": "regex",
      "pattern": "(?i)(?:aws_secret_access_key|AWS_SECRET)\\s*[=:]\\s*([A-Za-z0-9/+=]{40})",
      "placeholder": "AWS_SECRET",
      "severity": "high"
    },
    {
      "id": "secret.gitlab",
      "label": "GitLab token",
      "displayLabel": "GitLab token",
      "plural": "GitLab tokens",
      "kind": "regex",
      "pattern": "\\bglpat-[0-9A-Za-z_\\-]{20,}\\b",
      "placeholder": "GITLAB_TOKEN",
      "severity": "high"
    },
    {
      "id": "secret.huggingface",
      "label": "Hugging Face token",
      "displayLabel": "Hugging Face token",
      "plural": "Hugging Face tokens",
      "kind": "regex",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}\\b",
      "placeholder": "HF_TOKEN",
      "severity": "high"
    },
    {
      "id": "secret.sendgrid",
      "label": "SendGrid key",
      "displayLabel": "SendGrid key",
      "plural": "SendGrid keys",
      "kind": "regex",
      "pattern": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b",
      "placeholder": "SENDGRID_KEY",
      "severity": "high"
    },
    {
      "id": "secret.npm",
      "label": "npm token",
      "displayLabel": "npm token",
      "plural": "npm tokens",
      "kind": "regex",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "placeholder": "NPM_TOKEN",
      "severity": "high"
    },
    {
      "id": "secret.anthropic",
      "label": "Anthropic key",
      "displayLabel": "Anthropic key",
      "plural": "Anthropic keys",
      "kind": "regex",
      "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{16,}\\b",
      "placeholder": "ANTHROPIC_KEY",
      "severity": "block"
    },
    {
      "id": "secret.twilio",
      "label": "Twilio key",
      "displayLabel": "Twilio key",
      "plural": "Twilio keys",
      "kind": "regex",
      "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
      "placeholder": "TWILIO_KEY",
      "severity": "high"
    },
    {
      "id": "secret.azure",
      "label": "Azure storage key",
      "displayLabel": "Azure storage key",
      "plural": "Azure storage keys",
      "kind": "regex",
      "pattern": "(?i)(?:AccountKey|SharedAccessSignature)=[^;\\s\"']+",
      "placeholder": "AZURE_KEY",
      "severity": "high"
    },
    {
      "id": "secret.connection",
      "label": "Connection string",
      "displayLabel": "connection string",
      "plural": "connection strings",
      "kind": "regex",
      "pattern": "(?i)\\b[a-z][a-z0-9+.-]*:\\/\\/[^\\s:/@]+:[^\\s@]+@",
      "placeholder": "CONNECTION",
      "severity": "high"
    },
    {
      "id": "secret.password_assignment",
      "label": "Password assignment",
      "displayLabel": "password assignment",
      "plural": "password assignments",
      "kind": "regex",
      "pattern": "(?i)[A-Za-z0-9_.-]*(?:SECRET|PASSWORD|PASSWD|TOKEN|API_KEY|PRIVATE_KEY|PWD)[A-Za-z0-9_.-]*\\s*[=:]\\s*(?<value>[^;\\s\\\"']+)",
      "placeholder": "SECRET",
      "severity": "high"
    },
    {
      "id": "secret.discord",
      "label": "Discord token",
      "displayLabel": "Discord token",
      "plural": "Discord tokens",
      "kind": "regex",
      "pattern": "\\b[MNO][A-Za-z0-9_-]{23}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27}\\b",
      "placeholder": "DISCORD_TOKEN",
      "severity": "high"
    }
  ]
}
