<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BrandNavyColor">#071329</Color>
  <Color x:Key="BrandNavyDeepColor">#030712</Color>
  <Color x:Key="BrandNavyRaisedColor">#0B1236</Color>
  <Color x:Key="BrandCyanColor">#22D3EE</Color>
  <Color x:Key="BrandPurpleColor">#A78BFA</Color>
  <SolidColorBrush x:Key="BrandNavy" Color="{StaticResource BrandNavyColor}"/>
  <SolidColorBrush x:Key="BrandNavyDeep" Color="{StaticResource BrandNavyDeepColor}"/>
  <SolidColorBrush x:Key="BrandNavyRaised" Color="{StaticResource BrandNavyRaisedColor}"/>
  <SolidColorBrush x:Key="BrandCyan" Color="{StaticResource BrandCyanColor}"/>
  <SolidColorBrush x:Key="BrandPurple" Color="{StaticResource BrandPurpleColor}"/>
  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource BrandCyanColor}" Offset="0"/>
    <GradientStop Color="{StaticResource BrandPurpleColor}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarText" Color="#E6F1FF"/>
  <SolidColorBrush x:Key="SidebarMuted" Color="#9FB3D1"/>
  <SolidColorBrush x:Key="SidebarHover" Color="#142044"/>
  <SolidColorBrush x:Key="IconPaper" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="IconLine" Color="#9FB3D1"/>

  <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="FontWordmark">Bahnschrift SemiBold, Segoe UI</FontFamily>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontTitle">28</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSection">20</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontRow">15</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontBody">13</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontCaption">12</sys:Double>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
</ResourceDictionary>
