<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Background" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="Bg" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="Card" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="Fg" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="Muted" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="AccentHover" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="AccentSoft" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="OnAccent" Color="{x:Static SystemColors.HighlightTextColor}"/>
  <SolidColorBrush x:Key="Secondary" Color="{x:Static SystemColors.HotTrackColor}"/>
  <SolidColorBrush x:Key="Success" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="ClearSurface" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="Warning" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="WarningSurface" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="Danger" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="HighSurface" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="Neutral" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="NeutralSurface" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="Line" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="Field" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="BrandGradient" Color="{x:Static SystemColors.HighlightColor}"/>
</ResourceDictionary>
