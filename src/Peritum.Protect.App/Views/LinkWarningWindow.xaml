<Window x:Class="Peritum.Protect.App.Views.LinkWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Peritum.Protect.App"
        Title="PeritumAI Protect"
        AutomationProperties.AutomationId="LinkWarning"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
  <StackPanel Margin="22" Background="{DynamicResource Background}">
    <TextBlock Text="PeritumAI Protect"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Accent}"/>
    <TextBlock Text="{Binding Headline}"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,8,0,4"
               TextWrapping="Wrap"/>
    <TextBlock Text="{Binding CommandLine}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Visibility="{Binding ShowCommand, Converter={StaticResource BoolVis}}"/>
    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,0,8">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Links}" Margin="0,0,0,8">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="{Binding Before, Mode=OneWay}" Foreground="{DynamicResource Muted}"/><Run Text="{Binding Domain, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><Run Text="{Binding After, Mode=OneWay}" Foreground="{DynamicResource Muted}"/></TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{ui:Loc linkAlsoData}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Visibility="{Binding ShowData, Converter={StaticResource BoolVis}}"/>
    <WrapPanel>
      <Button Content="{Binding ClearLabel}"
              Style="{StaticResource PrimaryButton}"
              Command="{Binding ClearCommand}"/>
      <Button Content="{Binding KeepLabel}"
              Command="{Binding KeepCommand}"/>
      <Button Content="{Binding TrustLabel}"
              Command="{Binding TrustCommand}"
              IsEnabled="{Binding CanTrust}"/>
      <Button Content="{Binding RedactLabel}"
              Command="{Binding RedactCommand}"
              Visibility="{Binding ShowData, Converter={StaticResource BoolVis}}"/>
      <Button Content="{Binding WhyLabel}"
              Command="{Binding WhyCommand}"/>
    </WrapPanel>
  </StackPanel>
</Window>
