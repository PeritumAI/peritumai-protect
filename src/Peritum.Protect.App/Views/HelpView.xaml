<UserControl x:Class="Peritum.Protect.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Peritum.Protect.App"
             AutomationProperties.Name="{local:Loc helpName}"
             Background="{DynamicResource Background}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="4">
      <TextBlock Text="{local:Loc helpTitle}"
                 FontSize="24"
                 FontWeight="SemiBold"/>
      <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="{local:Loc tagline}"/>
      <TextBlock Margin="0,0,0,4" Text="{local:Loc positioning}"/>
      <TextBlock Margin="0,0,0,4"
                 Foreground="{DynamicResource Muted}"
                 Text="{local:Loc privacy}"/>
      <TextBlock Text="{local:Loc helpLinksTitle}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
      <TextBlock LineHeight="22"
                 TextWrapping="Wrap"
                 Text="{local:Loc helpLinksBody}"/>
      <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Text="{local:Loc helpLimits}"/>
      <TextBlock Margin="0,0,0,8">
        <Hyperlink NavigateUri="https://peritumai.com" RequestNavigate="OnSite" AutomationProperties.Name="peritumai.com">peritumai.com</Hyperlink>
      </TextBlock>
      <TextBlock x:Name="VersionLine"
                 Margin="0,0,0,4"
                 Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="AgeLine"
                 Margin="0,0,0,4"
                 Foreground="{DynamicResource Muted}"/>
      <TextBlock Margin="0,0,0,8">
        <Hyperlink Click="OnCheckNewer" AutomationProperties.Name="{local:Loc checkNewer}"><Run Text="{local:Loc checkNewer}"/></Hyperlink>
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
        <Hyperlink Click="OnNotices" AutomationProperties.Name="{local:Loc thirdParty}"><Run Text="{local:Loc thirdParty}"/></Hyperlink>
      </TextBlock>

      <TextBlock Text="{local:Loc helpCheckTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
      <TextBlock LineHeight="22"
                 Text="{local:Loc helpCheckBody}"/>

      <TextBlock Text="{local:Loc helpClipboardTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock LineHeight="22"
                 Text="{local:Loc helpClipboardBody}"/>

      <TextBlock Text="{local:Loc helpPolicyTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock LineHeight="22"
                 TextWrapping="Wrap"
                 Text="{local:Loc organizationPolicy}"/>

      <TextBlock Text="{local:Loc helpTermsTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock LineHeight="22"
                 Text="{local:Loc helpTermsBody}"/>

      <TextBlock Text="{local:Loc helpTrayTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock LineHeight="22"
                 Text="{local:Loc helpTrayBody}"/>

      <Border Background="{DynamicResource WarningSurface}"
              BorderBrush="{DynamicResource Warning}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14"
              Margin="0,20,0,0">
        <TextBlock LineHeight="21"
                   Foreground="{DynamicResource Warning}"
                   Text="{local:Loc helpCaution}"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
