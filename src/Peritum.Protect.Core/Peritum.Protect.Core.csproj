<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Peritum.Protect.Core</RootNamespace>
    <AssemblyName>Peritum.Protect.Core</AssemblyName>
    <Description>Offline scan, rules, and redaction. No UI and no network.</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\builtin\pii.json">
      <LogicalName>builtin.pii.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\builtin\secrets.json">
      <LogicalName>builtin.secrets.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\builtin\finance.json">
      <LogicalName>builtin.finance.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\builtin\labels.json">
      <LogicalName>builtin.labels.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\builtin\court-us.json">
      <LogicalName>builtin.court.us.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\builtin\court-eu.json">
      <LogicalName>builtin.court.eu.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\profiles\*.json">
      <LogicalName>profile.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\lang\en.json">
      <LogicalName>lang.en.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\country\*.json">
      <LogicalName>country.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\links\brands.json">
      <LogicalName>links.brands.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\links\country\*.json">
      <LogicalName>links.country.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\links\public_suffixes.txt">
      <LogicalName>links.public_suffixes.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\links\click_trackers.json">
      <LogicalName>links.click_trackers.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
